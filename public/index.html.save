<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Knowledge Assistant</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 20px auto;
            padding: 20px;
            background-color: #f5f5f5;
        }

        h1 {
            text-align: center;
        }

        .upload-section {
            background: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .chat-container {
            background: white;
            height: 500px;
            overflow-y: auto;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .message {
            margin: 10px 0;
            padding: 12px;
            border-radius: 10px;
            max-width: 80%;
            word-wrap: break-word;
        }

        .user {
            background-color: #007bff;
            color: white;
            margin-left: auto;
            text-align: right;
        }

        .assistant {
            background-color: #e9ecef;
            color: black;
        }

        .input-area {
            display: flex;
            gap: 10px;
        }

        #question {
            flex: 1;
            padding: 12px;
            font-size: 16px;
        }

        button {
            padding: 12px 20px;
            cursor: pointer;
        }

        #uploadStatus {
            margin-top: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<h1>AI Knowledge Assistant</h1>

<div class="upload-section">
    <h3>Upload Document</h3>

    <input
        type="file"
        id="fileInput"
        accept=".pdf,.txt,.doc,.docx">

    <button onclick="uploadFile()">
        Upload
    </button>

    <div id="uploadStatus"></div>
</div>

<div id="chat" class="chat-container"></div>

<div class="input-area">
    <input
        type="text"
        id="question"
        placeholder="Ask a question...">

    <button onclick="askQuestion()">
        Send
    </button>
</div>

<script>

async function uploadFile() {

    const fileInput = document.getElementById('fileInput');
    const file = fileInput.files[0];

    if (!file) {
        alert('Please select a file');
        return;
    }

    const formData = new FormData();
    formData.append('file', file);

    document.getElementById('uploadStatus').innerText =
        'Uploading...';

    try {

        const response = await fetch('/upload', {
            method: 'POST',
            body: formData
        });

        const message = await response.text();

        document.getElementById('uploadStatus').innerText =
            message;

    } catch (err) {

        document.getElementById('uploadStatus').innerText =
            'Upload failed';
    }
}

function addMessage(text, className) {

    const chat = document.getElementById('chat');

    const div = document.createElement('div');

    div.className = `message ${className}`;

    div.innerText = text;

    chat.appendChild(div);

    chat.scrollTop = chat.scrollHeight;

    return div;
}

async function askQuestion() {

    const questionInput =
        document.getElementById('question');

    const question =
        questionInput.value.trim();

    if (!question) {
        return;
    }

    addMessage(question, 'user');

    questionInput.value = '';

    const thinkingMessage =
        addMessage('Thinking...', 'assistant');

    try {

        const response = await fetch('/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
        });

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        thinkingMessage.innerText = '';

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            thinkingMessage.innerText += decoder.decode(value);
        }

    } catch (err) {

        thinkingMessage.innerText =
            'Error: ' + err.message;
    }
}

document
    .getElementById('question')
    .addEventListener('keypress', function(event) {

        if (event.key === 'Enter') {
            askQuestion();
        }
    });

</script>

</body>
</html>

<table>
    <thead>
        <tr>
            <th>S.No.</th>
            <th>Name</th>
            <th>Uploaded At</th>
            <th>Status</th>
            <th>Action</th> </tr>
    </thead>
    <tbody id="documentTableBody">
        </tbody>
</table>

async function loadDocuments() {
    const res = await fetch('/documents');
    const docs = await res.json();
    const tbody = document.getElementById('documentTableBody');
    tbody.innerHTML = '';
    
    if (docs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">No documents</td></tr>'; // Changed colspan to 5
        return;
    }
    
    let tableRows = '';
    for (let i = 0; i < docs.length; i++) {
        const d = docs[i];
        const date = new Date(d.uploaded_at).toLocaleString();
        const serialNumber = i + 1;
        
        tableRows += '<tr>' +
            '<td>' + serialNumber + '</td>' +
            '<td>' + d.file_name + '</td>' +
            '<td>' + date + '</td>' +
            '<td><span class="status-badge">Uploaded</span></td>' +
            // Add a delete button that triggers when clicked:
            '<td><button onclick="deleteDocument(' + d.id + ')">Delete</button></td>' +
        '</tr>';
    }
    
    tbody.innerHTML = tableRows;
}

async function deleteDocument(documentId) {
    // 1. Double check if the user actually wants to delete it
    if (confirm("Are you sure you want to delete this document?")) {
        
        // 2. Send a DELETE request to the server with the specific file ID
        const res = await fetch('/documents/' + documentId, {
            method: 'DELETE'
        });

        // 3. Check if the server successfully deleted it
        if (res.ok) {
            alert('Document deleted successfully!');
            loadDocuments(); // Refresh the table so the deleted file disappears
        } else {
            alert('Failed to delete the document.');
        }
    }
}

